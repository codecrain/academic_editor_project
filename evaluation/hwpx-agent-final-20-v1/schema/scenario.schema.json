{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academic-editor.local/schema/hwpx-public-sector-scenario-v1.json",
  "title": "HWPX Public-Sector Evaluation Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "mode",
    "difficulty",
    "domain",
    "title",
    "question",
    "attachments",
    "target",
    "sourceFacts",
    "factUsage",
    "requiredCapabilities",
    "oracle",
    "tags"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^HWPX-PS-[0-9]{3}$"
    },
    "version": {
      "const": "1.0.0"
    },
    "mode": {
      "enum": ["edit", "generation"]
    },
    "difficulty": {
      "const": "expert"
    },
    "domain": {
      "type": "string",
      "minLength": 2
    },
    "title": {
      "type": "string",
      "minLength": 10,
      "maxLength": 120
    },
    "question": {
      "type": "string",
      "minLength": 100,
      "maxLength": 1000
    },
    "attachments": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attachmentId", "outputFilename"],
      "properties": {
        "attachmentId": { "type": "string" },
        "outputFilename": {
          "type": "string",
          "pattern": "\\.hwpx$"
        }
      }
    },
    "sourceFacts": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["factId", "attachmentId", "locator", "fact"],
        "properties": {
          "factId": {
            "type": "string",
            "pattern": "^HWPX-PS-[0-9]{3}-F[0-9]{2}$"
          },
          "attachmentId": { "type": "string" },
          "locator": { "type": "string" },
          "fact": { "type": ["string", "number", "boolean"] }
        }
      }
    },
    "factUsage": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["factId", "expectedTargetId", "renderedText"],
        "properties": {
          "factId": {
            "type": "string",
            "pattern": "^HWPX-PS-[0-9]{3}-F[0-9]{2}$"
          },
          "expectedTargetId": { "type": "string", "minLength": 1 },
          "renderedText": { "type": "string", "minLength": 1 }
        }
      }
    },
    "requiredCapabilities": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commandTemplates",
        "expectedTargets",
        "invariants",
        "renderChecks",
        "score"
      ],
      "properties": {
        "commandTemplates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["op"],
            "properties": {
              "op": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "expectedTargets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["verificationId", "factIds", "location", "text"],
            "properties": {
              "verificationId": { "type": "string", "minLength": 1 },
              "factIds": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^HWPX-PS-[0-9]{3}-F[0-9]{2}$"
                }
              },
              "location": { "type": "object" },
              "text": { "type": "string" }
            }
          }
        },
        "invariants": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reopenRequired",
            "maxPageCountDelta",
            "preserveTableCount",
            "preservePictureCount",
            "preserveImageCount",
            "noUnexpectedTargetChanges"
          ],
          "properties": {
            "reopenRequired": { "const": true },
            "maxPageCountDelta": { "type": "integer", "minimum": 0, "maximum": 3 },
            "preserveTableCount": { "type": "boolean" },
            "preservePictureCount": { "type": "boolean" },
            "preserveImageCount": { "type": "boolean" },
            "noUnexpectedTargetChanges": { "type": "boolean" }
          }
        },
        "renderChecks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pages", "requireNonBlank", "compareBaseline"],
          "properties": {
            "pages": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "integer", "minimum": 1 }
            },
            "requireNonBlank": { "const": true },
            "compareBaseline": { "const": true }
          }
        },
        "score": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contentAccuracy",
            "layout",
            "styleConsistency",
            "objectPreservation",
            "packageIntegrity",
            "reopenAndApiUsability",
            "hardFailures"
          ],
          "properties": {
            "contentAccuracy": { "const": 35 },
            "layout": { "const": 20 },
            "styleConsistency": { "const": 15 },
            "objectPreservation": { "const": 10 },
            "packageIntegrity": { "const": 10 },
            "reopenAndApiUsability": { "const": 10 },
            "hardFailures": {
              "type": "array",
              "minItems": 3,
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": { "type": "string" }
    }
  }
}
